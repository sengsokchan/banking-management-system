# Development defaults. Copy to .env to override them.
# These values are for the local simulated portfolio only.

DB_NAME=banking
DB_USERNAME=banking
DB_PASSWORD=banking_dev_only
MYSQL_ROOT_PASSWORD=banking_root_dev_only

# At least 32 bytes. Replace this before sharing a deployment.
JWT_SECRET=dev-only-meridian-trust-jwt-secret-change-me

SEED_ADMIN_PASSWORD=ChangeMe-Admin-1
SEED_MANAGER_PASSWORD=ChangeMe-Manager-1
SEED_TELLER_PASSWORD=ChangeMe-Teller-1
SEED_AUDITOR_PASSWORD=ChangeMe-Auditor-1
